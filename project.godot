; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Super Mario 63 Redux"
config/version="0.2.0-dev"
run/main_scene="uid://bbqtk2trkbchr"
config/use_custom_user_dir=true
config/custom_user_dir_name="SM63Redux"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://cwc7nbr4m6n5q"
config/windows_native_icon="res://meta/icon.ico"

[autoload]

Singleton="*uid://gi77agsivaq5"
Settings="*uid://cvkmj15pmf6qf"
GdssRuntime="*uid://yu6lhnx763yp"

[debug]

gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display_server/driver.linuxbsd="wayland"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdss/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "red",
"res://dev/": "gray",
"res://game/": "blue",
"res://global/": "orange",
"res://meta/": "yellow",
"res://scenes/": "teal",
"res://shader/": "pink",
"res://util/": "purple"
}

