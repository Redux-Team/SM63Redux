# @chunk meta
@resources {
	BUTTON_FONT: font("uid://cf4ehcuf6rt7p")
	CAMPAIGN_TEXTURE: texture("uid://d2ms7egugej4j", NEAREST, true, true)
	LD_TEXTURE: texture("uid://cfdhtcrv76oix", NEAREST, true, true)
	EXTRA_TEXTURE: texture("uid://b213yk0c3jyc0", NEAREST, true, true)
	SETTINGS_TEXTURE: texture("uid://cn5mc2u0baujv", NEAREST, true, true)
	MYSTERY_TEXTURE: texture("uid://uxsyer7box1s", NEAREST, true, true)
	MAIN_FONT: font("uid://cnmgtcgow66hp")
	HOLLOW_FONT: font("uid://k76pvtok3f2u")
	PLAYTEST_TEXTURE: texture("uid://br1pxo7vu7i6m", NEAREST, true, true)
}


# @chunk Primary
@global var global_accent: "#6496ed"
var base_shadow_col: "#1B2A41"

Label {
	font: $MAIN_FONT
	
	Header {
		font_size: 38
	}
	
	Subheader {
		font_size: 28
	}
	
	InputBinding {
		font: $BUTTON_FONT
		font_size: 8
		font_color: $base_shadow_col
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 6
		padding: 8 8 4 4
	}
}

Button {
	cursor: POINTING
	
	GenericButton {
		font: $BUTTON_FONT 
		font_size: 8
		font_color: $base_shadow_col 
		corner_radius: 8
		padding: 12 12 8 8
		transition_time: 0.1
		
		:hover, :focus {
			border_color: $base_shadow_col 
			bg_color: $global_accent 
			transform_scale: 1.05
		}
		
		:pressed, :hover_pressed {
			bg_color: $base_shadow_col 
			font_color: WHITE
		}
	}
	
	SidebarButton {
		font: $BUTTON_FONT
		font_size: 8
		font_color: WHITE
		bg_color: TRANSPARENT_WHITE
		border: 0
		corner_radius: 6
		padding: 8 8 12 12
		
		:hover, :focus {
			bg_color: alpha(WHITE, 0.3)
			transform_scale: 1.05
		}
		
		:pressed {
			bg_color: $global_accent
		}
		
		:hover_pressed, :focus_pressed {
			bg_color: $global_accent
			transform_scale: 1.05
		}
	}
	
	CheckButtonBG {
		transition_type: EASE_OUT
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 99
		padding: 0
		
		:hover {
			border_color: $base_shadow_col
			transform_scale: 1
		}
		
		:focus {
			bg_color: $global_accent
			border_color: $base_shadow_col
			transform_scale: 1
		}
		
		:pressed, :hover_pressed {
			bg_color: $global_accent
			border_color: $global_accent
		}
		
		:focus_pressed {
			bg_color: $global_accent
			border_color: $base_shadow_col
			transform_scale: 1
		}
		
		:disabled {
			bg_color: mix(WHITE, $base_shadow_col, 0.35)
			border_color: alpha($base_shadow_col, 0.5)
			transform_scale: 1
		}
	}
}

Panel {
	CheckButtonDot {
		transition_time: 0.15
		transition_func: QUAD
		transition_type: EASE_IN_OUT
		transform_enabled: true
		bg_color: $base_shadow_col
		corner_radius: 99
		
		::on {
			bg_color: WHITE
			transform_position: 15 0
		}
	}
	
	SliderTrack {
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 99
		
		::disabled {
			bg_color: mix(WHITE, $base_shadow_col, 0.35)
			border_color: alpha($base_shadow_col, 0.5)
		}
	}
	
	SliderFill {
		bg_color: $global_accent 
		corner_radius: 99
		
		::disabled {
			bg_color: desaturate(alpha($global_accent, 0.5), 0.8)
		}
	}
	
	SliderGrabber {
		transition_time: 0.1
		transition_func: QUAD
		transition_type: EASE_OUT
		transform_enabled: true
		bg_color: WHITE
		corner_radius: 99
		border: 2
		border_color: $base_shadow_col
		
		::active {
			bg_color: $global_accent 
			transform_scale: 1.1
		}
		
		::pressed {
			bg_color: $base_shadow_col 
		}
		
		::disabled {
			bg_color: mix(WHITE, $base_shadow_col, 0.35)
			border_color: alpha($base_shadow_col, 0.5)
			transform_scale: 1
		}
	}
	
	TickMark {
		bg_color: alpha($base_shadow_col, 0.4)
		corner_radius: 99
		
		::filled {
			bg_color: alpha(WHITE, 0.4)
		}
	}
}

OptionButton {
	cursor: POINTING
	transition_time: 0.1
	font: $BUTTON_FONT
	font_size: 8
	font_color: $base_shadow_col
	bg_color: WHITE
	border: 2
	border_color: $base_shadow_col
	corner_radius: 8
	padding: 12 12 8 8
	arrow_margin: 10
	modulate_arrow: 1
	
	:hover, :focus {
		bg_color: $global_accent
		font_color: WHITE
	}
	
	:disabled {
		bg_color: mix(WHITE, $base_shadow_col, 0.35)
		font_color: alpha($base_shadow_col, 0.5)
		border_color: alpha($base_shadow_col, 0.5)
	}
}

#HSlider, VSlider {
	#corner_radius: 8
	#border: 2
	#border_color: $base_shadow_col 
	#padding: 6
	
	#:slider {
		#bg_color: WHITE
	#}
	
	#:grabber_area, :grabber_area_highlight {
		#corner_radius_top_right: 0
		#corner_radius_bottom_right: 0
		#border_right: 0
		#bg_color: $global_accent 
	#}
#}

PopupMenu {
	font: $BUTTON_FONT
	font_size: 8
	font_color: $base_shadow_col
	bg_color: WHITE
	border: 2
	border_color: $base_shadow_col
	corner_radius: 8
	
	:hover {
		bg_color: $global_accent
	}
}

PopupPanel {
	bg_color: WHITE
	border: 2
	border_color: $base_shadow_col
	corner_radius: 8
	padding: 6 6 6 6
}


# @chunk Title Screen
@global var blur_amount: 5.0
var shadow_drop: 0.65
var campaign_col: "#FF5D5D"
var ld_col: "#2FBF71"
var settings_col: "#8B93A1"

Panel {
	BlurPanel {
		transition_time: 0.2
		transition_func: CUBIC
		bg_color: blur($blur_amount, BLACK, 0.45)
		clip_path: polygon(0,0.25, 1,0.15, 1,0.75, 0,0.85)
		
		::open {
			clip_path: polygon(0,0, 1,0, 1,1, 0,1)
		}
	}
}

Label {
	InfoLabel {
		font_size: 20
		font_color: alpha(WHITE, 0.6)
		shadow_color: BLACK
	}
}

RichTextLabel {
	normal_font: $MAIN_FONT
	default_color: alpha(WHITE, 0.6)
	
	DebugLabel {
		bold_font: $MAIN_FONT 
		normal_font: $BUTTON_FONT 
		normal_font_size: 6
	}
}

Button {
	transition_time: 0.3
	transition_func: QUINT
	transition_type: EASE_OUT
	transform_enabled: true
	font: $MAIN_FONT
	font_size: 32
	font_color: $base_shadow_col
	bg_color: WHITE
	bg_scroll: 6 4
	border: 2
	border_color: $base_shadow_col
	shadow_color: $base_shadow_col
	corner_radius: 12
	padding: 30 30 14 14
	
	> Label {
		font: $HOLLOW_FONT
		font_size: 32
	}
	
	:hover, :focus {
		font_color: WHITE
		border_color: radial_gradient("#ffb600", YELLOW)
		transform_scale: 1.1
	}
	
	TitleButton {
		var accent: WHITE
		
		cursor: POINTING
		transition_time: 0 "bg_texture"
		transform_rotation: -0.05rad
		font_color: lighten($accent, 0.2)
		bg_tint: lighten($accent, 0.3)
		border_color: darken($accent, $shadow_drop)
		shadow_color: darken($accent, $shadow_drop)
		shadow_bottom: 1
		shadow_right: 1
		shadow_offset: 2
		shadow_blur: 0
		corner_radius_bottom_left: 4
		corner_radius_top_right: 4
		padding: 32 32 22 22
		
		> Label {
			font_color: darken($accent, $shadow_drop)
		}
		
		:hover, :focus {
			transition_time: 0.1 "bg_texture"
			transform_rotation: 0
			font_color: WHITE
			bg_color: $accent
			bg_texture: $art
			
			> Label {
				font_color: darken($accent, $shadow_drop)
			}
		}
		
		:disabled {
			cursor: DISABLED
			font_color: alpha($accent, 0.4)
			bg_color: alpha($accent, 0.5)
		}
		
		:pressed {
			transform_rotation: 0
			font_color: darken($accent, 0.4)
			bg_color: darken($accent, 0.2)
		}
		
		::launched {
			transition_time: 0.1 "bg_texture"
			transform_rotation: 0
			transform_scale: 1.1
			font_color: WHITE
			bg_color: $accent
			bg_texture: $art
		}
		
		CampaignButton {
			var accent: $campaign_col
			var art: $CAMPAIGN_TEXTURE
		}
		
		LDButton {
			var accent: $ld_col 
			var art: $LD_TEXTURE
		}
		
		TestLevelButton {
			var accent: $ld_col 
			var art: $PLAYTEST_TEXTURE 
			
			font_size: 26
			padding: 22 22 12 12
		}
		
		ReturnToLDButton {
			var accent: "#8B93A1"
			var art: $LD_TEXTURE
			
			font_size: 20
			padding: 22 22 12 12
		}
		
		TitleButtonSecondary {
			padding: 20 20 10 10
			font_size: 22
			
			> Label {
				font_size: 22
			}
			
			SettingsButton {
				var accent: $settings_col
				var art: $SETTINGS_TEXTURE
			}
			
			ExtraButton {
				var accent: "#4EA1F0"
				var art: $EXTRA_TEXTURE
			}
			
			MysteryButton {
				var accent: "#B07AE0"
				var art: $MYSTERY_TEXTURE
			}
		}
	}
}


# @chunk Level Designer
var ld_danger: "#E85A5A"

Panel {
	LDRoot {
		bg_color: TRANSPARENT
		
		>> Label {
			font: $MAIN_FONT
			font_size: 16
			font_color: WHITE
		}
		
		>> RichTextLabel {
			normal_font: $BUTTON_FONT
			normal_font_size: 8
			default_color: WHITE
		}
		
		>> PanelContainer {
			bg_color: TRANSPARENT
			border: 0
		}
		
		>> ScrollContainer {
			bg_color: TRANSPARENT
		}
		
		>> VSeparator {
			padding_left: 1
			bg_color: alpha(WHITE, 0.2)
		}
		
		>> HSeparator {
			padding_top: 1
			bg_color: alpha(WHITE, 0.2)
		}
	}
}

Button {
	EditorButton {
		transition_time: 0.1
		transition_func: QUAD
		transition_type: EASE_OUT
		transform_enabled: true
		transform_rotation: 0
		font: $BUTTON_FONT
		font_size: 8
		font_color: WHITE
		icon_color: WHITE
		bg_color: TRANSPARENT
		border: 0
		corner_radius: 8
		padding: 6 6 6 6
		
		:hover, :focus {
			font_color: WHITE
			icon_color: WHITE
			bg_color: alpha(WHITE, 0.3)
			transform_scale: 1.05
		}
		
		:pressed, :hover_pressed {
			font_color: WHITE
			bg_color: $global_accent
			transform_scale: 1.05
		}
		
		:disabled {
			cursor: ARROW
			font_color: alpha(WHITE, 0.3)
			icon_color: alpha(WHITE, 0.3)
			bg_color: TRANSPARENT
			transform_scale: 1
		}
		
		IconButton {
			padding: 5 5 5 5
		}
		
		ToolButton {
			padding: 5 5 5 5
		}
		
		Active {
			bg_color: $global_accent
			
			:hover, :focus {
				bg_color: lighten($global_accent, 0.15)
			}
		}
		
		ListRow {
			corner_radius: 6
			padding: 10 10 6 6
		}
		
		Chip {
			corner_radius: 6
			padding: 10 10 6 6
			
			:pressed, :hover_pressed {
				bg_color: $global_accent
				transform_scale: 1
			}
		}
		
		Flat {
			font_color: alpha(WHITE, 0.6)
			icon_color: alpha(WHITE, 0.6)
			icon_max_width: 10
			corner_radius: 4
			padding: 2 6 2 2
			
			:hover, :focus {
				font_color: WHITE
				icon_color: WHITE
				bg_color: TRANSPARENT
				transform_scale: 1
			}
			
			:pressed, :hover_pressed {
				font_color: alpha(WHITE, 0.6)
				icon_color: alpha(WHITE, 0.6)
				bg_color: TRANSPARENT
				transform_scale: 1
			}
		}
		
		Tile {
			font_color: WHITE
			bg_color: alpha(WHITE, 0.1)
			border: 2
			border_color: alpha(WHITE, 0.08)
			corner_radius: 8
			corner_radius_top_right: 3
			corner_radius_bottom_left: 3
			padding: 4 4 4 4
			
			:hover, :focus {
				bg_color: alpha(WHITE, 0.18)
				border_color: $global_accent
				transform_scale: 1.06
			}
			
			:pressed, :hover_pressed {
				bg_color: alpha($global_accent, 0.5)
				border_color: $global_accent
				transform_scale: 1
			}
		}
		
		Hotbar {
			bg_color: alpha(WHITE, 0.1)
			border: 2
			border_color: alpha(WHITE, 0.15)
			corner_radius: 8
			corner_radius_top_right: 3
			corner_radius_bottom_left: 3
			padding: 3 3 3 3
			
			:hover, :focus {
				bg_color: alpha(WHITE, 0.25)
				transform_rotation: -0.05rad
				transform_scale: 1.08
			}
			
			:disabled {
				bg_color: alpha(WHITE, 0.1)
			}
		}
		
		ViewportToggle {
			bg_color: liquid_blur($blur_amount, $base_shadow_col, 0.55, 1, 0.25)
			corner_radius: 10
			corner_radius_top_right: 4
			corner_radius_bottom_left: 4
			padding: 5 5 5 5
			
			:hover, :focus {
				bg_color: liquid_blur($blur_amount, lighten($base_shadow_col, 0.3), 0.6, 1, 0.3)
			}
		}
		
		Danger {
			:hover, :focus {
				bg_color: $ld_danger
			}
			
			:pressed, :hover_pressed {
				bg_color: darken($ld_danger, 0.2)
			}
		}
		
		Close {
			icon_color: $base_shadow_col
			bg_color: WHITE
			border: 2
			border_color: $base_shadow_col
			shadow_color: $base_shadow_col
			shadow_bottom: 1
			shadow_right: 1
			shadow_offset: 2
			shadow_blur: 0
			corner_radius: 99
			padding: 4 4 4 4
			
			:hover, :focus {
				icon_color: WHITE
				bg_color: $ld_danger
				transform_rotation: 0.1rad
			}
			
			:pressed, :hover_pressed {
				icon_color: WHITE
				bg_color: darken($ld_danger, 0.2)
			}
		}
		
		Primary {
			var accent: $global_accent
			
			font_color: $base_shadow_col
			icon_color: $base_shadow_col
			bg_color: WHITE
			border: 2
			border_color: $base_shadow_col
			shadow_color: $base_shadow_col
			shadow_bottom: 1
			shadow_right: 1
			shadow_offset: 2
			shadow_blur: 0
			corner_radius: 8
			corner_radius_top_right: 3
			corner_radius_bottom_left: 3
			padding: 12 12 8 8
			
			:hover, :focus {
				font_color: WHITE
				icon_color: WHITE
				bg_color: $accent
				transform_rotation: -0.04rad
			}
			
			:pressed, :hover_pressed {
				font_color: WHITE
				bg_color: darken($accent, 0.3)
				transform_rotation: 0
			}
			
			:disabled {
				font_color: alpha($base_shadow_col, 0.5)
				bg_color: alpha(WHITE, 0.5)
				transform_rotation: 0
				transform_scale: 1
			}
			
			PauseButton {
				font: $MAIN_FONT  
				font_size: 24
				padding: 40 40 8 8
				skew_x: 0.15
				font_color: lighten($accent, 0.2)
				bg_tint: lighten($accent, 0.3)
				border_color: darken($accent, $shadow_drop)
				shadow_color: darken($accent, $shadow_drop)
				
				:pressed {
					transform_scale: 0.9
				}
				
				PauseResume {
					var accent: $campaign_col 
				}
				
				PauseSettings {
					var accent: $settings_col 
				}
			}
		}
	}
}

PanelContainer {
	Bar {
		bg_color: liquid_blur($blur_amount, $base_shadow_col, 0.55, 1, 0.25)
		corner_radius: 12
		corner_radius_top_right: 4
		corner_radius_bottom_left: 4
		padding: 4 4 4 4
	}
	
	Bottom {
		padding: 8
	}
	
	Window {
		bg_color: blur($blur_amount, $base_shadow_col, 0.92)
		border: 2
		border_color: $base_shadow_col
		shadow_color: $base_shadow_col
		shadow_bottom: 1
		shadow_right: 1
		shadow_offset: 3
		shadow_blur: 0
		corner_radius: 14
		corner_radius_top_right: 5
		corner_radius_bottom_left: 5
		padding: 8 8 8 8
	}
	
	WindowTitle {
		bg_color: $global_accent
		border: 2
		border_color: $base_shadow_col
		shadow_color: $base_shadow_col
		shadow_bottom: 1
		shadow_right: 1
		shadow_offset: 2
		shadow_blur: 0
		corner_radius: 10
		corner_radius_top_right: 3
		corner_radius_bottom_left: 3
		padding: 12 12 2 2
	}
	
	Card {
		bg_color: alpha(BLACK, 0.25)
		corner_radius: 8
		padding: 10 10 10 10
	}
	
	Inset {
		bg_color: alpha(BLACK, 0.25)
		corner_radius: 8
		padding: 6 6 6 6
	}
	
	Group {
		bg_color: TRANSPARENT
		padding: 0 0 0 0
	}
}

Label {
	Title {
		font_size: 24
	}
	
	Dim {
		font_color: alpha(WHITE, 0.7)
	}
	
	Mute {
		font_color: alpha(WHITE, 0.5)
	}
	
	SectionHeader {
		font_color: alpha(WHITE, 0.6)
	}
}

LineEdit {
	InputField {
		cursor: IBEAM
		font: $BUTTON_FONT
		font_size: 8
		font_color: $base_shadow_col
		font_placeholder_color: alpha($base_shadow_col, 0.5)
		caret_color: $global_accent
		selection_color: alpha($global_accent, 0.45)
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 8
		padding: 8 8 10 10
		
		:focus {
			border_color: $global_accent
		}
		
		:read_only {
			bg_color: mix(WHITE, $base_shadow_col, 0.35)
			font_color: alpha($base_shadow_col, 0.5)
			border_color: alpha($base_shadow_col, 0.5)
		}
	}
}

TextEdit {
	InputField {
		cursor: IBEAM
		font: $BUTTON_FONT
		font_size: 8
		font_color: $base_shadow_col
		font_placeholder_color: alpha($base_shadow_col, 0.5)
		caret_color: $global_accent
		selection_color: alpha($global_accent, 0.45)
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 8
		padding: 8 8 10 10
		
		:focus {
			border_color: $global_accent
		}
		
		:read_only {
			bg_color: mix(WHITE, $base_shadow_col, 0.35)
			font_color: alpha($base_shadow_col, 0.5)
			border_color: alpha($base_shadow_col, 0.5)
		}
	}
}

ColorPickerButton {
	InputField {
		cursor: POINTING
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 0
		padding: 4 4 4 4
		
		:hover, :focus {
			border_color: $global_accent
		}
		
		:disabled {
			bg_color: mix(WHITE, $base_shadow_col, 0.35)
			border_color: alpha($base_shadow_col, 0.5)
		}
	}
}


# @chunk Tooltip

PanelContainer {
	TooltipBubble {
		bg_color: blur($blur_amount, BLACK, 0.6)
		corner_radius: 6
		padding: 8 8 4 4
	}
}

Panel {
	TooltipArrow {
		bg_color: blur($blur_amount, BLACK, 0.6)
		clip_path: polygon(0,1, 0.5,0, 1,1)
		
		TooltipArrowDown {
			clip_path: polygon(0,0, 0.5,1, 1,0)
		}
		
		TooltipArrowLeft {
			clip_path: polygon(1,0, 0,0.5, 1,1)
		}
		
		TooltipArrowRight {
			clip_path: polygon(0,0, 1,0.5, 0,1)
		}
	}
}

RichTextLabel {
	TooltipText {
		normal_font: $BUTTON_FONT
		normal_font_size: 8
		default_color: WHITE
	}
}

# @chunk Level
PanelContainer {
	PausePanel {
		bg_color: blur(4, BLACK, 0.5)
		clip_path: polygon(0,0 , 1,0 , 1,1, 0.2,1 )
	}
}
