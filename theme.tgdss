# @chunk meta
@resources {
	BUTTON_FONT: font("uid://cf4ehcuf6rt7p")
	CAMPAIGN_TEXTURE: texture("uid://d2ms7egugej4j", NEAREST, true, true)
	LD_TEXTURE: texture("uid://cfdhtcrv76oix", NEAREST, true, true)
	EXTRA_TEXTURE: texture("uid://b213yk0c3jyc0", NEAREST, true, true)
	SETTINGS_TEXTURE: texture("uid://cn5mc2u0baujv", NEAREST, true, true)
	MYSTERY_TEXTURE: texture("uid://uxsyer7box1s", NEAREST, true, true)
	MAIN_FONT: font("uid://cnmgtcgow66hp")
	HOLLOW_FONT: font("uid://k76pvtok3f2u")
}


# @chunk Primary
@global var global_accent: "#6496ed"
var base_shadow_col: "#1B2A41"

Label {
	font: $MAIN_FONT
	
	Header {
		font_size: 38
	}
	
	Subheader {
		font_size: 28
	}
	
	InputBinding {
		font: $BUTTON_FONT
		font_size: 8
		font_color: $base_shadow_col
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 6
		padding: 8 8 4 4
	}
}

Button {
	cursor: POINTING
	
	GenericButton {
		font: $BUTTON_FONT 
		font_size: 8
		font_color: $base_shadow_col 
		corner_radius: 8
		padding: 12 12 8 8
		transition_time: 0.1
		
		:hover, :focus {
			border_color: $base_shadow_col 
			bg_color: $global_accent 
			transform_scale: 1.05
		}
		
		:pressed, :hover_pressed {
			bg_color: $base_shadow_col 
			font_color: WHITE
		}
	}
	
	SidebarButton {
		font: $BUTTON_FONT
		font_size: 8
		font_color: WHITE
		bg_color: TRANSPARENT_WHITE
		border: 0
		corner_radius: 6
		padding: 8 8 12 12
		
		:hover, :focus {
			bg_color: alpha(WHITE, 0.3)
			transform_scale: 1.05
		}
		
		:pressed {
			bg_color: $global_accent
		}
		
		:hover_pressed, :focus_pressed {
			bg_color: $global_accent
			transform_scale: 1.05
		}
	}
	
	CheckButtonBG {
		transition_type: EASE_OUT
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 99
		padding: 0
		
		:hover {
			border_color: $base_shadow_col
			transform_scale: 1
		}
		
		:focus {
			bg_color: $global_accent
			border_color: $base_shadow_col
			transform_scale: 1
		}
		
		:pressed, :hover_pressed {
			bg_color: $global_accent
			border_color: $global_accent
		}
		
		:focus_pressed {
			bg_color: $global_accent
			border_color: $base_shadow_col
			transform_scale: 1
		}
	}
}

Panel {
	CheckButtonDot {
		transition_time: 0.15
		transition_func: QUAD
		transition_type: EASE_IN_OUT
		transform_enabled: true
		bg_color: $base_shadow_col
		corner_radius: 99
		
		::on {
			bg_color: WHITE
			transform_position: 15 0
		}
	}
	
	SliderTrack {
		bg_color: WHITE
		border: 2
		border_color: $base_shadow_col
		corner_radius: 99
	}
	
	SliderFill {
		bg_color: $global_accent 
		corner_radius: 99
	}
	
	SliderGrabber {
		transition_time: 0.1
		transition_func: QUAD
		transition_type: EASE_OUT
		transform_enabled: true
		bg_color: WHITE
		corner_radius: 99
		border: 2
		border_color: $base_shadow_col
		
		::active {
			bg_color: $global_accent 
			transform_scale: 1.1
		}
		
		::pressed {
			bg_color: $base_shadow_col 
		}
	}
	
	TickMark {
		bg_color: alpha($base_shadow_col, 0.4)
		corner_radius: 99
		
		::filled {
			bg_color: alpha(WHITE, 0.4)
		}
	}
}

OptionButton {
	cursor: POINTING
	transition_time: 0.1
	font: $BUTTON_FONT
	font_size: 8
	font_color: $base_shadow_col
	bg_color: WHITE
	border: 2
	border_color: $base_shadow_col
	corner_radius: 8
	padding: 12 12 8 8
	arrow_margin: 10
	modulate_arrow: 1
	
	:hover, :focus {
		bg_color: $global_accent
		font_color: WHITE
	}
}

#HSlider, VSlider {
	#corner_radius: 8
	#border: 2
	#border_color: $base_shadow_col 
	#padding: 6
	
	#:slider {
		#bg_color: WHITE
	#}
	
	#:grabber_area, :grabber_area_highlight {
		#corner_radius_top_right: 0
		#corner_radius_bottom_right: 0
		#border_right: 0
		#bg_color: $global_accent 
	#}
#}

PopupMenu {
	font: $BUTTON_FONT
	font_size: 8
	font_color: $base_shadow_col
	bg_color: WHITE
	border: 2
	border_color: $base_shadow_col
	corner_radius: 8
	
	:hover {
		bg_color: $global_accent
	}
}


# @chunk Title Screen
var shadow_drop: 0.65

Panel {
	BlurPanel {
		transition_time: 0.2
		transition_func: CUBIC
		bg_color: blur(5, BLACK, 0.45)
		clip_path: polygon(0,0.25, 1,0.15, 1,0.75, 0,0.85)
		
		::open {
			clip_path: polygon(0,0, 1,0, 1,1, 0,1)
		}
	}
}

Label {
	InfoLabel {
		font_size: 20
		font_color: alpha(WHITE, 0.6)
		shadow_color: BLACK
	}
}

RichTextLabel {
	normal_font: $MAIN_FONT
	default_color: alpha(WHITE, 0.6)
}

Button {
	transition_time: 0.3
	transition_func: QUINT
	transition_type: EASE_OUT
	transform_enabled: true
	font: $MAIN_FONT
	font_size: 32
	font_color: $base_shadow_col
	bg_color: WHITE
	bg_scroll: 6 4
	border: 2
	border_color: $base_shadow_col
	shadow_color: $base_shadow_col
	corner_radius: 12
	padding: 30 30 14 14
	
	> Label {
		font: $HOLLOW_FONT
		font_size: 32
	}
	
	:hover, :focus {
		font_color: WHITE
		border_color: radial_gradient("#ffb600", YELLOW)
		transform_scale: 1.1
	}
	
	TitleButton {
		var accent: WHITE
		
		cursor: POINTING
		transition_time: 0 "bg_texture"
		transform_rotation: -0.05rad
		font_color: lighten($accent, 0.2)
		bg_tint: lighten($accent, 0.3)
		border_color: darken($accent, $shadow_drop)
		shadow_color: darken($accent, $shadow_drop)
		shadow_bottom: 1
		shadow_right: 1
		shadow_offset: 2
		shadow_blur: 0
		corner_radius_bottom_left: 4
		corner_radius_top_right: 4
		padding: 32 32 22 22
		
		> Label {
			font_color: darken($accent, $shadow_drop)
		}
		
		:hover, :focus {
			transition_time: 0.1 "bg_texture"
			transform_rotation: 0
			font_color: WHITE
			bg_color: $accent
			bg_texture: $art
			
			> Label {
				font_color: darken($accent, $shadow_drop)
			}
		}
		
		:disabled {
			cursor: DISABLED
			font_color: alpha($accent, 0.4)
			bg_color: alpha($accent, 0.5)
		}
		
		:pressed {
			transform_rotation: 0
			font_color: darken($accent, 0.4)
			bg_color: darken($accent, 0.2)
		}
		
		CampaignButton {
			var accent: "#FF5D5D"
			var art: $CAMPAIGN_TEXTURE
		}
		
		LDButton {
			var accent: "#2FBF71"
			var art: $LD_TEXTURE
		}
		
		TitleButtonSecondary {
			padding: 20 20 10 10
			font_size: 22
			
			> Label {
				font_size: 22
			}
			
			SettingsButton {
				var accent: "#8B93A1"
				var art: $SETTINGS_TEXTURE
			}
			
			ExtraButton {
				var accent: "#4EA1F0"
				var art: $EXTRA_TEXTURE
			}
			
			MysteryButton {
				var accent: "#B07AE0"
				var art: $MYSTERY_TEXTURE
			}
		}
	}
}