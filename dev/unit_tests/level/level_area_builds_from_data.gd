static func run_test() -> void:
	var data: AreaData = AreaData.create("Main Area")
	data.camera_position = Vector2(32.0, 64.0)
	data.camera_zoom = 1.5
	data.active_layer = 1
	data.layers.clear()
	var back: LayerData = LayerData.create(2)
	var middle: LayerData = LayerData.create(0)
	var front: LayerData = LayerData.create(1)
	data.layers.append_array([back, middle, front])
	var coin: ObjectData = ObjectData.create(&"yellow_coin")
	coin.position = Vector2(16.0, -16.0)
	middle.objects.append(coin)
	front.objects.append(ObjectData.create(&"goomba"))
	front.objects.append(ObjectData.create(&"missing_object_id"))
	data.layer_groups.append({"uuid": &"group", "distance": 2.0, "is_decoration": true, "modulation": Color.RED, "enabled": false, "visible": false})
	back.group = &"group"
	back.distance = 0.5
	
	var area: LevelArea = LevelArea.build(data, GameObject.Context.EDITOR)
	assert(area.name == "Main Area")
	assert(area.uuid == data.uuid)
	assert(area.camera_position == data.camera_position)
	assert(area.camera_zoom == 1.5)
	assert(area.active_layer == 1)
	var layers: Array[LevelLayer] = area.get_layers()
	assert(layers.size() == 3)
	for i: int in layers.size():
		assert(layers.get(i).index == i)
		assert(layers.get(i).z_index == i * LevelLayer.Z_STRIDE)
		assert(layers.get(i).get_index() == i)
	assert(area.get_layer(2).name == "Layer2")
	assert(area.get_layer(7) == null)
	
	assert(area.get_all_objects().size() == 2)
	var coin_object: GameObject = area.find_object(coin.uuid)
	assert(coin_object.position == coin.position)
	assert(area.get_layer_of(coin_object) == area.get_layer(0))
	assert(area.find_object(&"missing") == null)
	var stray: Node2D = Node2D.new()
	area.add_child(stray)
	assert(area.get_layers().size() == 3)
	
	var grouped: LevelLayer = area.get_layer(2)
	assert(grouped.group_decoration)
	assert(grouped.is_effective_decoration())
	assert(not grouped.is_decoration)
	assert(is_equal_approx(grouped.get_effective_distance(), 2.5))
	assert(not grouped.is_effective_enabled())
	assert(not grouped.is_effective_visible())
	assert(not grouped.visible)
	assert(grouped.get_objects_root().process_mode == Node.PROCESS_MODE_DISABLED)
	assert(is_equal_approx(grouped.modulate.a, LevelLayer.DISABLED_ALPHA))
	assert(grouped.modulate.r == 1.0 and grouped.modulate.g == 0.0)
	assert(area.get_layer(0).get_objects_root().process_mode == Node.PROCESS_MODE_INHERIT)
	
	area.layer_groups.clear()
	area.apply_layer_groups()
	assert(not grouped.is_effective_decoration())
	assert(grouped.get_effective_distance() == 0.5)
	assert(grouped.is_effective_enabled())
	assert(grouped.visible)
	assert(grouped.modulate == Color.WHITE)
	area.layer_groups = data.layer_groups.duplicate(true)
	area.apply_layer_groups()
	
	var created: LevelLayer = area.get_or_create_layer(-1)
	assert(created.index == -1)
	assert(area.get_layers().front() == created)
	assert(created.z_index == 0)
	assert(area.get_layer(2).z_index == 3 * LevelLayer.Z_STRIDE)
	assert(area.get_or_create_layer(-1) == created)
	assert(area.get_layers().size() == 4)
	area.remove_layer(created)
	assert(area.get_layers().size() == 3)
	assert(created.get_parent() == null)
	created.free()
	
	var captured: AreaData = area.capture()
	assert(captured.layers.size() == 3)
	assert(captured.layer_groups == data.layer_groups)
	assert((captured.layers.get(0) as LayerData).objects.size() == 1)
	assert((captured.layers.get(1) as LayerData).objects.size() == 1)
	assert((captured.layers.get(2) as LayerData).group == &"group")
	var plain: AreaData = area.to_data()
	assert(plain.layers.is_empty())
	assert(plain.area_name == "Main Area")
	area.free()
	
	var game_data: AreaData = AreaData.create("Game")
	var disabled: LayerData = LayerData.create(1)
	disabled.enabled = false
	disabled.objects.append(ObjectData.create(&"yellow_coin"))
	var hidden: LayerData = LayerData.create(2)
	hidden.editor_visible = false
	var group_disabled: LayerData = LayerData.create(3)
	group_disabled.group = &"off"
	game_data.layer_groups.append({"uuid": &"off", "enabled": false, "visible": false})
	game_data.layers.append_array([disabled, hidden, group_disabled])
	var game_area: LevelArea = LevelArea.build(game_data, GameObject.Context.GAME)
	assert(game_area.get_layers().size() == 2)
	assert(game_area.get_layer(1) == null)
	assert(game_area.get_layer(3) == null)
	assert(game_area.get_layer(2).visible)
	assert(game_area.get_layer(2).editor_visible)
	game_area.free()
	
	var editor_area: LevelArea = LevelArea.build(game_data, GameObject.Context.EDITOR)
	assert(editor_area.get_layers().size() == 4)
	assert(not editor_area.get_layer(2).visible)
	editor_area.free()
